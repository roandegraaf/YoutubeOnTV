<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>YoutubeOnTV</AssemblyName>
    <RootNamespace>YoutubeOnTV</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Build-Thunderstore expects bin\$(Configuration)\, not a net472 subfolder -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Properties\AssemblyInfo.cs already declares these attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    Prefer the local game/mod installs when present, otherwise fall back to the
    assemblies fetch-libs.sh downloads into libs/. That keeps a Windows box with
    Lethal Company installed building exactly as before, and lets any other
    machine build without the game.
  -->
  <PropertyGroup>
    <GameManagedDir>..\..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\Lethal Company\Lethal Company_Data\Managed</GameManagedDir>
    <GameManagedDir Condition="!Exists('$(GameManagedDir)\Assembly-CSharp.dll')">$(MSBuildProjectDirectory)/../libs</GameManagedDir>

    <YoutubeDLSharpDir>C:\Users\gfhoi\AppData\Roaming\r2modmanPlus-local\LethalCompany\profiles\dev\BepInEx\plugins\Lordfirespeed-YoutubeDLSharp</YoutubeDLSharpDir>
    <YoutubeDLSharpDir Condition="!Exists('$(YoutubeDLSharpDir)\YoutubeDLSharp.dll')">$(MSBuildProjectDirectory)/../libs</YoutubeDLSharpDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(GameManagedDir)/Unity.Netcode.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManagedDir)/Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)/UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="YoutubeDLSharp">
      <HintPath>$(YoutubeDLSharpDir)/YoutubeDLSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
    <PackageReference Include="ILRepack">
      <Version>2.0.44</Version>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" />
    <PackageReference Include="Xilophor.LethalNetworkAPI" Version="3.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="fallback.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <PostBuildEvent>if not exist "C:\Users\gfhoi\AppData\Roaming\r2modmanPlus-local\LethalCompany\profiles\dev\BepInEx\plugins\YoutubeOnTV" mkdir "C:\Users\gfhoi\AppData\Roaming\r2modmanPlus-local\LethalCompany\profiles\dev\BepInEx\plugins\YoutubeOnTV"
copy "$(TargetPath)" "C:\Users\gfhoi\AppData\Roaming\r2modmanPlus-local\LethalCompany\profiles\dev\BepInEx\plugins\YoutubeOnTV\" /Y
copy "$(TargetDir)fallback.mp4" "C:\Users\gfhoi\AppData\Roaming\r2modmanPlus-local\LethalCompany\profiles\dev\BepInEx\plugins\YoutubeOnTV\" /Y</PostBuildEvent>
  </PropertyGroup>

</Project>
