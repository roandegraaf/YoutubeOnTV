<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the mod's Unity-free logic. The source files are linked rather than
    referenced, because the mod assembly itself needs Unity and the game to load.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../YoutubeOnTV/VideoInput.cs" Link="Linked/VideoInput.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
